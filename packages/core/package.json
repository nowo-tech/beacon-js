{
  "name": "@nowo-tech/beacon-core",
  "version": "0.2.0",
  "description": "Beacon SDK core: event model, Sentry-compatible envelope encoder, transport, scopes. Zero runtime dependencies.",
  "keywords": [
    "beacon",
    "error-tracking",
    "sentry-compatible",
    "envelope"
  ],
  "license": "MIT",
  "author": "nowo-tech",
  "homepage": "https://github.com/nowo-tech/beacon-js/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nowo-tech/beacon-js.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/nowo-tech/beacon-js/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../tooling/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "beaconBuild": {
    "platform": "neutral",
    "entries": [
      {
        "in": "src/index.ts",
        "out": "index",
        "formats": [
          "esm",
          "cjs"
        ]
      }
    ]
  }
}
